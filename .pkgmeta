package-as: ManaSigil

# Versionshinweise für CurseForge aus der Changelog-Datei
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Diese Dateien gehören nur ins Repository, nicht ins Addon-Paket
ignore:
  - tools
  - docs
  - .github
  - .gitignore
  - .pkgmeta
  - README.md
  - .release
  - .cfbuild
